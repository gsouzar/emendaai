<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/verde_fundo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margem_tela">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_detalhe"
            android:textColor="@color/texto_suave"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtNomeFeriado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/verde_android"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDataFeriado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/texto_claro"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/txtContagemFeriado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/texto_suave"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtAvisoEmenda"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/selo_emenda"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="Cai no meio da semana. Dá emenda."
            android:textColor="@color/verde_cartao"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/rotulo_cep"
            android:textColor="@color/texto_suave"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/campoCep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/fundo_campo"
            android:hint="@string/dica_cep"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="9"
            android:padding="14dp"
            android:textColor="@color/texto_claro"
            android:textColorHint="@color/texto_suave" />

        <Button
            android:id="@+id/btnBuscarCep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/btn_buscar_cep" />

        <ProgressBar
            android:id="@+id/progressoCep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtResultadoCep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/fundo_cartao"
            android:padding="14dp"
            android:textColor="@color/texto_claro"
            android:textSize="15sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnCompartilhar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:enabled="false"
            android:text="@string/btn_compartilhar" />

    </LinearLayout>
</ScrollView>
